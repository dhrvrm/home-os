{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "home-os",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/.well-known/*", "/healthz", "/readyz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-os",
      "database_id": "385f5895-4ddc-48c6-b3fc-cd861989d49b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "HOMEOS_DEFAULT_HOUSEHOLD_ID": "home",
    "BETTER_AUTH_URL": "https://home-os.dhruvverma028.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "home-os",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "home.dhruvverma.dev",
      "custom_domain": true
    }
  ],
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/healthz",
      "/readyz",
      "/.well-known/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-os",
      "database_id": "385f5895-4ddc-48c6-b3fc-cd861989d49b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "HOMEOS_DEFAULT_HOUSEHOLD_ID": "home",
    "HOMEOS_VAPID_SUBJECT": "https://home.dhruvverma.dev",
    "HOMEOS_MCP_RESOURCE": "https://home.dhruvverma.dev/mcp"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "e27b57dd7fa94d6eb96a621ecfc86d3d"
    }
  ]
}

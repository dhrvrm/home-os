HOMEOS_MCP_TOKEN=replace-with-a-long-random-local-token
HOMEOS_SETUP_TOKEN=replace-with-an-independent-random-setup-key
HOMEOS_PASSWORD_PEPPER=replace-with-an-independent-random-secret-at-least-32-characters

# Optional Web Push: independent P-256 VAPID key pair (base64url).
# Without these keys the in-app meal reminder inbox still works.
# HOMEOS_VAPID_PUBLIC_KEY=
# HOMEOS_VAPID_PRIVATE_KEY=
